 * JSON string literal encoded as a C string: outer quotes below belong to C.
 * Empty configuration compiles but explicitly disables upload. */
#define APP_INGEST_TOKEN_CONFIGURED 0
#define APP_INGEST_TOKEN_JSON "\"\""
#endif
