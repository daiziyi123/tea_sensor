# Local defaults. Copy this file to .env.
HTTP_HOST=127.0.0.1
HTTP_PORT=8000
TCP_HOST=127.0.0.1
TCP_PORT=9000
DATABASE_PATH=data/tea_sense.db
# Cloud MySQL settings. Keep credentials in the private .env.
# MYSQL_DSN=mysql://user:password@db.example.com:3306/database
# For Docker, put the provider's CA bundle in deploy/ and use the container path.
# MYSQL_SSL_CA=/srv/tea/deploy/ApsaraDB-CA-Chain.pem
ONLINE_SECONDS=540
# Authenticated idle only; pre-auth and incomplete JSON remain separate 300s limits.
AUTHENTICATED_IDLE_SECONDS=600

# Native DTU GPS: only after authenticated V2 on the SAME TCP connection.
# Example IMEI is fictional; real bindings belong only in private .env.
GPS_IMEI_BINDINGS={}
# GPS_IMEI_BINDINGS={"990000000000001":"demo_h743_001"}
GPS_COORDINATE_SYSTEM=UNKNOWN
GPS_STALE_SECONDS=540
GPS_FUTURE_TOLERANCE_SECONDS=300

# Use different, random values before exposing the service.
# TCP_HOST=0.0.0.0 requires INGEST_TOKEN.
# For public read-only access, set PUBLIC_DASHBOARD=1 and leave VIEW_TOKEN empty.
INGEST_TOKEN=
VIEW_TOKEN=
PUBLIC_DASHBOARD=0

# Docker web port is local-only by default; use a reverse proxy for public HTTPS.
WEB_BIND=127.0.0.1
